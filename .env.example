# Trading account (MT5 terminal runs on Windows or under Wine on Ubuntu)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Runtime profile: local or vps
ALGOLAB_PROFILE=vps

# Ollama on your remote machine (use its URL and key)
OLLAMA_URL=https://your-ollama-host:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b

# Cloud LLM for the optional advisor
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-haiku-5-5

# Safety: keep true until a demo run is verified
DRY_RUN=true

# Dashboard: every request needs this password. Unset = the dashboard refuses to start.
DASH_PASSWORD=
# Writes from the dashboard (start trading, promote a candidate, edit prop rules). Stop is always allowed.
DASH_ALLOW_WRITES=false
